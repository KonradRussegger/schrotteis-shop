# Supabase (Projekt -> Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Mollie (Dashboard -> Entwickler -> API-Schlüssel)
MOLLIE_API_KEY=

# sevDesk (Einstellungen -> Benutzer -> API-Token) — nur mit Tarif "Buchhaltung Pro"
SEVDESK_API_TOKEN=

# Öffentliche URL der Seite (lokal: http://localhost:3000, live: eigene Domain)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Admin-Bereich (/admin) — HTTP-Basic-Auth
ADMIN_USER=admin
ADMIN_PASSWORD=bitte-aendern
